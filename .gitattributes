# Keep text files normalized to LF across macOS, Linux and Windows.
* text=auto eol=lf

# Windows batch scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Mark binary assets explicitly so Git never rewrites line endings inside them.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.bmp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
